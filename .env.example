ZENDSMS_API_KEY=your_zendsms_api_key_or_bearer_token
ZENDSMS_SENDER_ID=8809612781020

# Redis (BullMQ - Optional)
REDIS_URL=redis://localhost:6379

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
