# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Postman
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.qnhfjkl.mongodb.net/smspro_production?retryWrites=true&w=majority

# Authentication Secret
AUTH_SECRET=your-32-character-secret-key-here

# Tracking Base URL
TRACKING_BASE_URL=https://go.mybrand.com/t

# Primary SMS Provider (ZendSMS)
SMS_PROVIDER=zendsms
ZENDSMS_API_URL=https://api.zendsms.com/api/v1/send-sms
