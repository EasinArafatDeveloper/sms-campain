# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SMSPro
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.qnhfjkl.mongodb.net/smspro_production?retryWrites=true&w=majority

# Authentication Secret
AUTH_SECRET=your-32-character-secret-key-here

# Tracking Base URL
TRACKING_BASE_URL=https://go.mybrand.com/t

# Primary SMS Provider
SMS_PROVIDER=bulksmsbd
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=your_sender_id

# Redis (BullMQ - Optional)
REDIS_URL=redis://localhost:6379

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
